# Copy this file to .env and fill in your values.
# Get a free Groq API key at https://console.groq.com

GROQ_API_KEY=your_groq_api_key_here

# Port the Express server listens on (default: 4000)
PORT=4000

# Your deployed frontend URL — used to whitelist CORS in production
# Example: https://studyai.vercel.app
# Leave empty for local development (localhost is always allowed)
FRONTEND_URL=
